# کپی به partFBackend/.env و تنظیم مقادیر محیط واقعی
DATABASE_URL=postgres://ce_user:ce_pass@localhost:5432/ce_dashboard
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# اصالت‌سنجی پارت (partAuthenticationInterface)
PART_AUTH_USERNAME=نام_کاربری_سرویس_اصالت_سنجی
PART_AUTH_PASS=رمز_عبور_سرویس_اصالت_سنجی
PART_AUTH_SYSTEM=نام_سیستم_در_اصالت_سنجی

# سرویس سمد (SamadService — اساین و دریافت نقش‌های کاربران)
org=نام_سازمان_در_سمد
samadServiceUrl=http://samad-v8-dev.partdp.ir
user=نام_کاربری_سمد
pass=رمز_عبور_سمد

# API اصلی گزارشهای اعتبارسنجی
CE_API_BASE_URL=http://creditevaluation-v2.ara.partdp.ir/creditEvaluation@2/report
CE_GATEWAY_SYSTEM=creditEvaluation
CE_GATEWAY_TOKEN=توکن_گیت_وی_اینجا
CE_API_PAGE_SIZE=50
CE_API_TIMEOUT_MS=20000
CE_API_RETRY=3
# CE_REDACT_NATIONAL_CODE=true
