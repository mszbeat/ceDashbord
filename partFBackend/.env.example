# کپی به partFBackend/.env و تنظیم مقادیر محیط واقعی
DATABASE_URL=postgres://ce_user:ce_pass@localhost:5432/ce_dashboard
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# API اصلی گزارشهای اعتبارسنجی
CE_API_BASE_URL=http://creditevaluation-v2.ara.partdp.ir/creditEvaluation@2/report
CE_GATEWAY_SYSTEM=creditEvaluation
CE_GATEWAY_TOKEN=توکن_گیت_وی_اینجا
CE_API_PAGE_SIZE=50
CE_API_TIMEOUT_MS=20000
CE_API_RETRY=3
# CE_REDACT_NATIONAL_CODE=true

# ─── تنظیمات سطح دسترسی و نقشها (user | creditEvaluation | admin) ───
# در حالت واقعی نقشها بهطور خودکار از protocolRef.session (partSessionManager) یا setAuthResolver خوانده میشوند.
# برای تست محلی پیش از اتصال سرویس احراز هویت میتوانید یکی از موارد زیر را فعال کنید:
# AUTH_DEV_DEFAULT_ROLE=              # خالی = کاربر عادی (user) | مقادیر مجاز برای تست: creditEvaluation | admin
# AUTH_TRUST_ROLE_HEADERS=false       # در صورت true بودن، هدر x-user-role / x-user-roles خوانده میشود
# AUTH_JWT_SECRET=                    # در صورت استفاده از Bearer JWT با الگوریتم HS256
