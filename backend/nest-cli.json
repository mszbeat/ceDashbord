{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      "evaluator/legacy/**/*.js",
      "evaluator/legacy-report/**/*.js",
      "legacy-report/**/*.js",
      "legacy-report/assets/*.css",
      "legacy-report/assets/*.js",
      "db/*.sql"
    ],
    "watchAssets": true
  }
}
