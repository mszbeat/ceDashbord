{
  "info": {
    "_postman_id": "2c8c9e47-9d1a-4b4e-8f57-ce00da54b0fd",
    "name": "CE Dashboard (partFramework Backend)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "0. Auth & Session (authController)",
      "item": [
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"secret\",\n  \"rememberMe\": true\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "POST /api/auth/refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/api/auth/refresh"
          }
        },
        { "name": "GET /api/auth/me", "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" } },
        { "name": "POST /api/auth/logout", "request": { "method": "POST", "url": "{{baseUrl}}/api/auth/logout" } }
      ]
    },
    {
      "name": "1. Public / Normal User (summaryController)",
      "item": [
        { "name": "GET /api/health", "request": { "method": "GET", "url": "{{baseUrl}}/api/health" } },
        { "name": "GET /api/banks", "request": { "method": "GET", "url": "{{baseUrl}}/api/banks" } },
        { "name": "GET /api/specs", "request": { "method": "GET", "url": "{{baseUrl}}/api/specs?bank=tavan_mellat" } },
        { "name": "GET /api/report (HTML)", "request": { "method": "GET", "url": "{{baseUrl}}/api/report?bank=tavan_mellat" } },
        { "name": "GET /api/summary", "request": { "method": "GET", "url": "{{baseUrl}}/api/summary?bank=tavan_mellat" } },
        { "name": "GET /api/diagnostics", "request": { "method": "GET", "url": "{{baseUrl}}/api/diagnostics" } },
        { "name": "GET /api/list", "request": { "method": "GET", "url": "{{baseUrl}}/api/list?bank=tavan_mellat&limit=25&offset=0" } },
        { "name": "GET /api/runs", "request": { "method": "GET", "url": "{{baseUrl}}/api/runs" } }
      ]
    },
    {
      "name": "2. Role: creditEvaluation | admin (creditEvaluationController)",
      "item": [
        { "name": "GET /api/sample?requestId=…", "request": { "method": "GET", "url": "{{baseUrl}}/api/sample?requestId=REQ-001&bank=tavan_mellat" } }
      ]
    },
    {
      "name": "3. Role: admin Only (adminController)",
      "item": [
        { "name": "GET /api/admin/overview", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/overview" } },
        { "name": "GET /api/admin/cron", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/cron" } },
        {
          "name": "PUT /api/admin/cron",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true,\n  \"schedule_mode\": \"daily\",\n  \"hour\": 3,\n  \"minute\": 0,\n  \"banks\": [\"tavan_mellat\", \"tavan_resalat\", \"tavan_postbank\"]\n}"
            },
            "url": "{{baseUrl}}/api/admin/cron"
          }
        },
        { "name": "POST /api/admin/cron/run-now", "request": { "method": "POST", "url": "{{baseUrl}}/api/admin/cron/run-now" } },
        {
          "name": "POST /api/admin/runs/check",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"banks\": [\"tavan_mellat\"],\n  \"dateScope\": \"single\",\n  \"day\": \"1405-08-23\"\n}"
            },
            "url": "{{baseUrl}}/api/admin/runs/check"
          }
        },
        {
          "name": "POST /api/admin/runs/start",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"banks\": [\"tavan_mellat\"],\n  \"dateScope\": \"single\",\n  \"day\": \"1405-08-23\",\n  \"mode\": \"nightly\",\n  \"conflictStrategy\": \"upsert\",\n  \"confirmedConflict\": true\n}"
            },
            "url": "{{baseUrl}}/api/admin/runs/start"
          }
        },
        {
          "name": "POST /api/admin/runs",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bank\": \"tavan_mellat\",\n  \"day\": \"1405-08-23\",\n  \"mode\": \"nightly\",\n  \"rebuild\": false\n}"
            },
            "url": "{{baseUrl}}/api/admin/runs"
          }
        },
        { "name": "GET /api/admin/jobs", "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/jobs" } }
      ]
    }
  ]
}
