# کپی به backend/.env و تنظیم مقادیر محیط واقعی
DATABASE_URL=postgres://ce_user:ce_pass@localhost:5432/ce_dashboard
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# ── اصالت‌سنجی پارت (partAuthenticationInterface) ──
PART_AUTH_USERNAME=نام_کاربری_سرویس_اصالت_سنجی
PART_AUTH_PASS=رمز_عبور_سرویس_اصالت_سنجی
PART_AUTH_SYSTEM=ceDashboard
# PART_AUTH_HOST=authentication.partdp.ir
# PART_AUTH_PROTOCOL=http
# PART_AUTH_PORT=80
# PART_AUTH_GATEWAY_ENABLE=false

# ── سرویس سمد (تخصیص/خواندن نقش، و گارد دسترسی روت‌ها) ──
SAMAD_ORG=mohammadsadeghZarei
SAMAD_SERVICE_URL=http://samad-v8-dev.partdp.ir
SAMAD_BASE_URL=http://samad.partdp.ir
SAMAD_USER=mohammadsadeghZarei
SAMAD_PASS=mohammadsadeghZarei
SAMAD_TIMEOUT_MS=7000
# تنظیمات اختیاری گارد دسترسی partSamadInterface (پیش‌فرض مستقیم روی samad-v8-dev.partdp.ir بدون gateway):
# SAMAD_HOST=samad-v8-dev.partdp.ir
# SAMAD_PROTOCOL=http
# SAMAD_PORT=80
# SAMAD_GATEWAY_ENABLE=false

# ── هاست گزارش هر بانک (مسیر /creditEvaluation@2/report به‌صورت خودکار اضافه می‌شود) ──
# فقط HOST_NAME را وارد کنید: http://<HOST_NAME>/creditEvaluation@2/report
CE_REPORT_HOST_MELLAT=HOST_NAME
CE_REPORT_HOST_RESALAT=HOST_NAME
CE_REPORT_HOST_POSTBANK=HOST_NAME
# پروتکل پیش‌فرض گزارش (http):
# CE_REPORT_PROTOCOL=http

# ── تنظیمات اختصاصی گیت‌وی هر بانک (فقط ملت و پست‌بانک — رسالت بدون گیت‌وی است) ──
# آدرس توکن به‌صورت خودکار ساخته می‌شود: https://<HOST_NAME>/service/gateway@3/token

# بانک ملت:
CE_GATEWAY_HOST_MELLAT=HOST_NAME
CE_GATEWAY_SYSTEM_MELLAT=creditEvaluation
# در صورت متفاوت بودن فیلد system در بدنهٔ درخواست توکن با هدر gateway-system:
# CE_GATEWAY_TOKEN_SYSTEM_MELLAT=
CE_GATEWAY_USERNAME_MELLAT=نام_کاربری_گیت_وی_ملت
CE_GATEWAY_PASSWORD_MELLAT=رمز_عبور_گیت_وی_ملت
CE_GATEWAY_PASS_HEADER_MELLAT=
CE_GATEWAY_TOKEN_MELLAT=

# پست‌بانک:
CE_GATEWAY_HOST_POSTBANK=HOST_NAME
CE_GATEWAY_SYSTEM_POSTBANK=creditEvaluation
# CE_GATEWAY_TOKEN_SYSTEM_POSTBANK=
CE_GATEWAY_USERNAME_POSTBANK=نام_کاربری_گیت_وی_پستبانک
CE_GATEWAY_PASSWORD_POSTBANK=رمز_عبور_گیت_وی_پستبانک
CE_GATEWAY_PASS_HEADER_POSTBANK=
CE_GATEWAY_TOKEN_POSTBANK=

CE_API_PAGE_SIZE=50
CE_API_TIMEOUT_MS=20000
CE_API_RETRY=3
# CE_REDACT_NATIONAL_CODE=true

# ── مدت‌زمان اعتبار نشست و Refresh Token (به‌صورت میلی‌ثانیه یا مثل 30m / 24h / 14d) ──
REFRESH_TOKEN_TTL_MS=86400000
REFRESH_TOKEN_REMEMBER_TTL_MS=1209600000
SESSION_EXPIRE_MS=300000
SESSION_IDLE_MS=120000
# COOKIE_DOMAIN=
# COOKIE_SECURE=false
