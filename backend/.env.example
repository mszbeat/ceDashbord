# کپی به backend/.env و تنظیم مقادیر محیط واقعی
DATABASE_URL=postgres://ce_user:ce_pass@localhost:5432/ce_dashboard
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# ── اصالت‌سنجی پارت (partAuthenticationInterface) ──
PART_AUTH_USERNAME=نام_کاربری_سرویس_اصالت_سنجی
PART_AUTH_PASS=رمز_عبور_سرویس_اصالت_سنجی
PART_AUTH_SYSTEM=ceDashboard
# PART_AUTH_HOST=authentication.partdp.ir
# PART_AUTH_PROTOCOL=http
# PART_AUTH_PORT=80
# PART_AUTH_GATEWAY_ENABLE=false

# ── سرویس سمد (تخصیص/خواندن نقش، و گارد دسترسی روت‌ها) ──
SAMAD_ORG=mohammadsadeghZarei
SAMAD_SERVICE_URL=http://samad-v8-dev.partdp.ir
SAMAD_BASE_URL=http://samad.partdp.ir
SAMAD_USER=mohammadsadeghZarei
SAMAD_PASS=mohammadsadeghZarei
SAMAD_TIMEOUT_MS=7000
# تنظیمات اختیاری گارد دسترسی partSamadInterface (پیش‌فرض مستقیم روی samad-v8-dev.partdp.ir بدون gateway):
# SAMAD_HOST=samad-v8-dev.partdp.ir
# SAMAD_PROTOCOL=http
# SAMAD_PORT=80
# SAMAD_GATEWAY_ENABLE=false

# ── API اصلی گزارش‌های اعتبارسنجی ──
CE_API_BASE_URL=http://creditevaluation-v2.ara.partdp.ir/creditEvaluation@2/report
CE_GATEWAY_SYSTEM=creditEvaluation
CE_GATEWAY_TOKEN=توکن_گیت_وی_اینجا
CE_API_PAGE_SIZE=50
CE_API_TIMEOUT_MS=20000
CE_API_RETRY=3
# CE_REDACT_NATIONAL_CODE=true

# ── نشست و رفرش‌توکن (برای تمدید خودکار هنگام کوتاه‌بودن عمر Access Token) ──
# REFRESH_TOKEN_TTL_MS=86400000
# REFRESH_TOKEN_REMEMBER_TTL_MS=1209600000
# COOKIE_DOMAIN=
# COOKIE_SECURE=false
