# کپی به backend/.env و تنظیم مقادیر محیط واقعی
DATABASE_URL=postgres://ce_user:ce_pass@localhost:5432/ce_dashboard
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# ── اصالت‌سنجی پارت (partAuthenticationInterface) ──
PART_AUTH_USERNAME=نام_کاربری_سرویس_اصالت_سنجی
PART_AUTH_PASS=رمز_عبور_سرویس_اصالت_سنجی
PART_AUTH_SYSTEM=ceDashboard
# PART_AUTH_HOST=authentication.partdp.ir
# PART_AUTH_PROTOCOL=http
# PART_AUTH_PORT=80
# PART_AUTH_GATEWAY_ENABLE=false

# ── سرویس سمد (تخصیص/خواندن نقش، و گارد دسترسی روت‌ها) ──
SAMAD_ORG=mohammadsadeghZarei
SAMAD_SERVICE_URL=http://samad-v8-dev.partdp.ir
SAMAD_BASE_URL=http://samad.partdp.ir
SAMAD_USER=mohammadsadeghZarei
SAMAD_PASS=mohammadsadeghZarei
SAMAD_TIMEOUT_MS=7000
# تنظیمات اختیاری گارد دسترسی partSamadInterface (پیش‌فرض مستقیم روی samad-v8-dev.partdp.ir بدون gateway):
# SAMAD_HOST=samad-v8-dev.partdp.ir
# SAMAD_PROTOCOL=http
# SAMAD_PORT=80
# SAMAD_GATEWAY_ENABLE=false

# ── لینک اختصاصی API هر بانک (ملت و پست‌بانک با گیت‌وی، رسالت بدون گیت‌وی) ──
CE_API_URL_MELLAT=http://creditevaluation-v2.ara.partdp.ir/creditEvaluation@2/report
CE_API_URL_RESALAT=http://creditevaluation-v2.ara.partdp.ir/creditEvaluation@2/report
CE_API_URL_POSTBANK=http://creditevaluation-v2.ara.partdp.ir/creditEvaluation@2/report
# لینک پیش‌فرض در صورت خالی بودن هر یک از لینک‌های بالا:
CE_API_BASE_URL=http://creditevaluation-v2.ara.partdp.ir/creditEvaluation@2/report

# ── تنظیمات گیت‌وی (فقط برای ملت و پست‌بانک — دریافت خودکار توکن هنگام invalidToken) ──
CE_GATEWAY_TOKEN_URL=https://HOST_NAME/service/gateway@3/token
# یا به‌جای CE_GATEWAY_TOKEN_URL می‌توانید فقط هاست را تنظیم کنید:
# CE_GATEWAY_HOST=HOST_NAME
CE_GATEWAY_SYSTEM=creditEvaluation
CE_GATEWAY_USERNAME=نام_کاربری_گیت_وی
CE_GATEWAY_PASSWORD=رمز_عبور_گیت_وی
CE_GATEWAY_PASS_HEADER=
# توکن اولیه اختیاری (اگر خالی یا منقضی باشد به‌صورت خودکار از سرویس گیت‌وی گرفته می‌شود):
CE_GATEWAY_TOKEN=
CE_API_PAGE_SIZE=50
CE_API_TIMEOUT_MS=20000
CE_API_RETRY=3
# CE_REDACT_NATIONAL_CODE=true

# ── مدت‌زمان اعتبار نشست و Refresh Token (به‌صورت میلی‌ثانیه یا مثل 30m / 24h / 14d) ──
REFRESH_TOKEN_TTL_MS=86400000
REFRESH_TOKEN_REMEMBER_TTL_MS=1209600000
SESSION_EXPIRE_MS=300000
SESSION_IDLE_MS=120000
# COOKIE_DOMAIN=
# COOKIE_SECURE=false
