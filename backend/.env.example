# کپی کن به backend/.env و مقادیر واقعی را بگذار
DATABASE_URL=postgres://ce_user:ce_pass@localhost:5432/ce_dashboard
BACKEND_PORT=3000

# API اصلی گزارشها (همانی که report/ قبلاً استفاده میکرد)
CE_API_BASE_URL=http://creditevaluation-v2.ara.partdp.ir/creditEvaluation@2/report
CE_GATEWAY_SYSTEM=creditEvaluation
CE_GATEWAY_TOKEN=توکن_گیت_وی_اینجا
CE_API_PAGE_SIZE=50
CE_API_TIMEOUT_MS=20000
CE_API_RETRY=3
CE_REDACT_NATIONAL_CODE=true
