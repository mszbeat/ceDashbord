# آدرس بک‌اند از دید سرور Next.js (نه مرورگر)
# مرورگر همیشه /api صدا می‌زند و Next.js آن را پروکسی می‌کند.
BACKEND_URL=http://127.0.0.1:3000

# --- F2: تحویل نشست از middleware به صفحه -------------------------------------
# اگر تنظیم شود، middleware نشستِ تأییدشده را در هدر امضاشده (HMAC) به صفحه می‌دهد و
# `/api/auth/me` یک بار به‌جای دو بار صدا زده می‌شود. بدون آن، رفتار قبلی (probe دوباره) برمی‌گردد.
# مقدار: رشتهٔ تصادفی ۳۲ بایتی (مثال: openssl rand -hex 32)
# CE_SESSION_HANDOFF_SECRET=

# --- F1: مهلتِ پاسخ بک‌اند در مسیر گزارش ---------------------------------------
# اگر بک‌اند تا این مدت هدر پاسخ را نفرستد، خطای «سرور گزارش پاسخ نداد» نشان داده می‌شود.
# بدنهٔ گزارش همچنان به‌صورت جریان (stream) پاس داده می‌شود و محدود به این مهلت نیست.
# CE_REPORT_HEADERS_TIMEOUT_MS=30000

# آستانهٔ بافر کردن پاسخِ JSON کوچکی که HTML را درون خود دارد (برای سازگاری با پاسخ‌های قدیمی)
# CE_REPORT_INLINE_MAX_BYTES=65536

# --- امنیت پل BFF --------------------------------------------------------------
# همان مقدار `CE_BFF_SHARED_SECRET` بک‌اند. اگر تنظیم نشود، Next.js هدر امضاشده نمی‌فرستد
# و بک‌اند فقط درخواست‌های شبکهٔ خصوصی/داخلی را می‌پذیرد (که معمولاً شامل استقرار دو‌هاستی
# روی یک LAN است). برای امنیت قوی‌تر یا بک‌اند با IP عمومی، در هر دو طرف تنظیم کنید.
# تولید مقدار: openssl rand -hex 32
# CE_BFF_SHARED_SECRET=
